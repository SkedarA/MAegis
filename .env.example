MAEGIS_ENVIRONMENT=development
MAEGIS_DATABASE_URL=postgresql+psycopg://maegis:maegis@localhost:5432/maegis
MAEGIS_API_KEY=change-me
MAEGIS_CAPTURE_ENABLED=false
MAEGIS_DISCOVERY_BRAND_BATCH_SIZE=5
MAEGIS_DISCOVERY_POLL_INTERVAL_SECONDS=900
MAEGIS_CT_SEARCH_URL=https://crt.sh/
MAEGIS_RDAP_BASE_URL=https://rdap.org/domain/
MAEGIS_URLHAUS_AUTH_KEY=
MAEGIS_CZDS_DIRECTORY=./data/czds
MAEGIS_AI_BASE_URL=
MAEGIS_AI_API_KEY=
MAEGIS_AI_MODEL=local-model

# Used only by the web server to proxy the private API. Never expose these as NEXT_PUBLIC variables.
MAEGIS_API_URL=http://localhost:8000
